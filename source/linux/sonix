#!/usr/bin/gjs

imports.gi.versions.Gtk = '3.0';
imports.gi.versions.WebKit2 = '4.1';
const {Gio, GLib, Gtk, WebKit2} = imports.gi;
const launcher = 'https://sonixdeveloper.github.io/sonix-downloads/launch.html';
const previewPattern = /^https:\/\/[a-z0-9-]+\.trycloudflare\.com(?=\/|$)/;

const app = new Gtk.Application({application_id: 'io.github.SonixDeveloper.Sonix'});
app.connect('activate', () => {
    if (app.active_window) {
        app.active_window.present();
        return;
    }
    const window = new Gtk.ApplicationWindow({application: app, title: 'Sonix', default_width: 1160, default_height: 760});
    const data = new WebKit2.WebsiteDataManager({
        base_data_directory: GLib.build_filenamev([GLib.get_user_data_dir(), 'sonix', 'web']),
        base_cache_directory: GLib.build_filenamev([GLib.get_user_cache_dir(), 'sonix', 'web']),
    });
    const context = WebKit2.WebContext.new_with_website_data_manager(data);
    const web = WebKit2.WebView.new_with_context(context);
    web.get_settings().set_enable_media_stream(true);
    let previewOrigin = null;

    web.connect('decide-policy', (_view, decision, kind) => {
        if (kind !== WebKit2.PolicyDecisionType.NAVIGATION_ACTION &&
            kind !== WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION) return false;
        const url = decision.get_navigation_action().get_request().get_uri();
        if (kind === WebKit2.PolicyDecisionType.NAVIGATION_ACTION) {
            if (url === launcher || url === 'about:blank') return false;
            const origin = url.match(previewPattern)?.[0];
            if (origin && (origin === previewOrigin || (!previewOrigin && web.get_uri() === launcher))) {
                previewOrigin = origin;
                return false;
            }
        }
        decision.ignore();
        if (/^https?:\/\//.test(url)) {
            try { Gio.AppInfo.launch_default_for_uri(url, null); } catch (error) { logError(error); }
        }
        return true;
    });
    web.connect('permission-request', (_view, request) => {
        if (!(request instanceof WebKit2.UserMediaPermissionRequest) || !previewOrigin ||
            !web.get_uri()?.startsWith(previewOrigin + '/')) {
            request.deny();
            return true;
        }
        const dialog = new Gtk.MessageDialog({
            transient_for: window, modal: true, message_type: Gtk.MessageType.QUESTION,
            buttons: Gtk.ButtonsType.YES_NO, text: 'Allow Sonix to use the requested media devices?',
        });
        dialog.connect('response', (_dialog, response) => {
            if (response === Gtk.ResponseType.YES) request.allow();
            else request.deny();
            dialog.destroy();
        });
        dialog.show();
        return true;
    });
    window.add(web);
    window.show_all();
    let refreshed = false;
    web.connect('load-changed', (_view, event) => {
        if (!refreshed && event === WebKit2.LoadEvent.FINISHED && previewOrigin &&
            web.get_uri()?.startsWith(previewOrigin + '/')) {
            refreshed = true;
            web.reload_bypass_cache();
        }
    });
    web.load_uri(launcher);
});
app.run(ARGV);
